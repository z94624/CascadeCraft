# CascadeCraft Environment Variables Template
# Copy this file to .env and customize your local/production settings

# Public Site Domain (used for canonical URLs, sitemaps, robots.txt, and GEO llms.txt)
NUXT_PUBLIC_SITE_URL=https://z94624.github.io/CascadeCraft

# Google Search Console Verification Token
GOOGLE_SITE_VERIFICATION=your_google_verification_token_here

# Google AdSense Monetization (Leave blank until AdSense is approved)
NUXT_PUBLIC_ADSENSE_CLIENT=
NUXT_PUBLIC_ADSENSE_SLOT=
